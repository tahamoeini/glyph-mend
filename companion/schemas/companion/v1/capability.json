{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glyphmend.companion/v1/capability",
  "title": "Capability descriptor",
  "type": "object",
  "required": [
    "id",
    "version",
    "providerKind",
    "inputSchema",
    "outputSchema",
    "executionLocations",
    "deterministic",
    "requiresModel",
    "confidenceCalibrated",
    "privacyClass",
    "diagnosticOnly",
    "irSchemaVersion"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "providerKind": {
      "enum": [
        "deterministic",
        "hybrid-local",
        "ml"
      ]
    },
    "inputSchema": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "outputSchema": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "executionLocations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128,
        "minLength": 1
      },
      "maxItems": 16
    },
    "deterministic": {
      "type": "boolean"
    },
    "requiresModel": {
      "type": "boolean"
    },
    "confidenceCalibrated": {
      "type": "boolean"
    },
    "privacyClass": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "diagnosticOnly": {
      "type": "boolean"
    },
    "irSchemaVersion": {
      "type": "integer",
      "minimum": 1
    }
  }
}
