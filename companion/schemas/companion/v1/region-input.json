{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glyphmend.companion/v1/region-input",
  "title": "Region input metadata",
  "type": "object",
  "required": [
    "schema",
    "page",
    "bbox",
    "sourceIds",
    "deterministicSummary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "glyphmend.region-input.v1"
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "bbox": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 256
    },
    "deterministicSummary": {
      "type": "object"
    }
  },
  "maxProperties": 5
}
