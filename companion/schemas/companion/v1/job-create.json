{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glyphmend.companion/v1/job-create",
  "title": "Job creation request",
  "type": "object",
  "required": [
    "documentName",
    "capabilityId",
    "inputKind",
    "declaredBytes",
    "pageCount",
    "metadata",
    "idempotencyKey"
  ],
  "additionalProperties": false,
  "properties": {
    "documentName": {
      "type": "string",
      "maxLength": 255
    },
    "capabilityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "inputKind": {
      "enum": [
        "document",
        "region"
      ]
    },
    "declaredBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 536870912
    },
    "pageCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "metadata": {
      "type": "object",
      "description": "At most 16 KiB serialized. For inputKind=region, must match region-input.json."
    },
    "idempotencyKey": {
      "type": "string",
      "format": "uuid"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "inputKind": {
            "const": "region"
          }
        },
        "required": [
          "inputKind"
        ]
      },
      "then": {
        "properties": {
          "metadata": {
            "$ref": "./region-input.json"
          }
        }
      }
    }
  ]
}
