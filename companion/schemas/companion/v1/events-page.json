{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glyphmend.companion/v1/events-page",
  "title": "Event page",
  "type": "object",
  "required": [
    "events",
    "nextSequence",
    "earliestSequence",
    "historyTruncated",
    "terminal"
  ],
  "additionalProperties": false,
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "$ref": "./job-event.json"
      },
      "maxItems": 128
    },
    "nextSequence": {
      "type": "integer",
      "minimum": 0
    },
    "earliestSequence": {
      "type": "integer",
      "minimum": 1
    },
    "historyTruncated": {
      "type": "boolean"
    },
    "terminal": {
      "type": "boolean"
    }
  }
}
