{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glyphmend.semantic-document-ir/v2",
  "title": "Semantic Document IR v2",
  "type": "object",
  "required": ["schema", "schemaVersion", "documentId", "pages", "diagnostics"],
  "properties": {
    "schema": { "const": "glyphmend.semantic-document-ir" },
    "schemaVersion": { "const": 2 },
    "documentId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "metadata": { "type": "object" },
    "pages": {
      "type": "array", "minItems": 1, "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["pageNumber", "sourcePage", "bbox", "coordinateSpace", "nodes", "diagnostics"],
        "properties": {
          "pageNumber": { "type": "integer", "minimum": 1 },
          "sourcePage": { "type": "integer", "minimum": 1 },
          "bbox": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": { "type": "number" }
          },
          "coordinateSpace": { "enum": ["page-points", "normalized-page", "crop-pixels", "document-points", "unknown"] },
          "nodes": { "type": "array", "items": { "type": "object" } },
          "diagnostics": { "type": "array", "items": { "type": "object" } }
        },
        "additionalProperties": true
      }
    },
    "diagnostics": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": true
}
